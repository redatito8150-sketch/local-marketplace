{
  "expo": {
    "name": "Mahaly",
    "slug": "mahaly",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mahaly",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mahaly to attach photos to your product review."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F1E8",
          "dark": {
            "backgroundColor": "#11100F"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mahaly.mobile"
    },
    "android": {
      "package": "com.mahaly.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F7F1E8"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
