{
  "expo": {
    "name": "Mahaly",
    "slug": "mahaly",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mahaly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mahaly.mobile"
    },
    "android": {
      "package": "com.mahaly.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F7F1E8"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
