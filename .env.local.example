# Copy this file to .env.local and fill in your own Supabase project values.
# Find these under Supabase Dashboard → Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER put the service_role/secret key here or in any NEXT_PUBLIC_ variable.
# It only belongs in server-only environments (e.g. a seed script run locally,
# or Vercel's server-side environment variables for admin-only API routes).
#
# Required locally for app/api/orders/route.ts (order placement) — find it
# under Supabase Dashboard → Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same value as NEXT_PUBLIC_SUPABASE_URL above — scripts/seed.mjs reads
# this separate, non-NEXT_PUBLIC_-prefixed name specifically (its own env
# var, not shared with the app's build-time config).
SUPABASE_URL=https://your-project.supabase.co

# Transactional email (order confirmation/shipped/cancelled). Get a key at
# https://resend.com — server-only, never a NEXT_PUBLIC_ variable.
RESEND_API_KEY=your-resend-api-key

# Discord log mirroring — each is a per-channel webhook URL (Channel Settings
# → Integrations → Webhooks → New Webhook). All optional: if unset,
# sendToDiscord() silently no-ops for that channel. Server-only, never a
# NEXT_PUBLIC_ variable.
DISCORD_WEBHOOK_NOTIFICATIONS=your-notifications-channel-webhook-url
DISCORD_WEBHOOK_ERRORS=your-errors-channel-webhook-url

# Audit log mirroring — split into one channel per activity category
# instead of a single #audit-log firehose, so each can be watched (or
# muted) independently. Same "optional, no-ops if unset" rule as above —
# set only the ones you've actually created a Discord channel + webhook
# for; the rest just stay silent until you do.
DISCORD_WEBHOOK_AUDIT_PRODUCTS=your-audit-products-channel-webhook-url
DISCORD_WEBHOOK_AUDIT_BRANDS=your-audit-brands-channel-webhook-url
DISCORD_WEBHOOK_AUDIT_ORDERS=your-audit-orders-channel-webhook-url
DISCORD_WEBHOOK_AUDIT_APPLICATIONS=your-audit-applications-channel-webhook-url
DISCORD_WEBHOOK_AUDIT_USERS_ROLES=your-audit-users-roles-channel-webhook-url
DISCORD_WEBHOOK_AUDIT_COLLECTIONS=your-audit-collections-channel-webhook-url
DISCORD_WEBHOOK_AUDIT_INVENTORY=your-audit-inventory-channel-webhook-url
DISCORD_WEBHOOK_AUDIT_PRODUCT_OPTIONS=your-audit-product-options-channel-webhook-url
DISCORD_WEBHOOK_AUDIT_REVIEWS=your-audit-reviews-channel-webhook-url
DISCORD_WEBHOOK_AUDIT_SITE_MARKETING=your-audit-site-marketing-channel-webhook-url

# Google Social Login — set to "true" only after Google Provider is
# actually enabled and configured in the Supabase Dashboard (see
# docs/google-auth-setup.md). Leave unset/"false" and the "Continue with
# Google" button doesn't render at all, anywhere — never show a button that
# looks like it works when the provider isn't wired up yet.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Phone verification (SMS OTP on /account/security) — INTENTIONALLY
# DISABLED FOR NOW. Keep this "false" until a production SMS provider
# (Twilio/Vonage/etc) has actually been contracted and wired into
# lib/sms.ts's sendSms() — flipping it to "true" today just logs the OTP to
# the server console instead of texting it, which is fine for local
# testing but not for real users. The security page shows a plain "Phone
# verification is coming soon" notice instead of an OTP form while this is
# false, and registration/login/checkout are completely unaffected either
# way — phone verification has never been required for any of those.
SMS_VERIFICATION_ENABLED=false
